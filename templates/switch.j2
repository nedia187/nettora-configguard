{% for v in vlans %}
vlan {{ v.id }}
 name {{ v.name }}
{% endfor %}
{% for p in access_ports %}
interface {{ p.name }}
 description {{ p.description }}
 switchport mode access
 switchport access vlan {{ p.vlan }}
 no shutdown
{% endfor %}
{% for t in trunks %}
interface {{ t.name }}
 description {{ t.description }}
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan {{ t.allowed_vlans | join(',') }}
 {% if t.native_vlan is defined %}
 switchport trunk native vlan {{ t.native_vlan }}
{% endif %}
 no shutdown
{% endfor %}
